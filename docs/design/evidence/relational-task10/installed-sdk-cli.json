            {
              "id": "3",
              "name": "Total"
            }
          ],
          "sql": "SELECT c.CustomerID, c.Name,\n       COUNT(o.OrderID) AS OrderCount,\n       COALESCE(SUM(o.Quantity * o.UnitPrice), 0) AS Total\nFROM Customers AS c\nLEFT JOIN Orders AS o ON o.CustomerID = c.CustomerID\nGROUP BY c.CustomerID, c.Name\nHAVING COALESCE(SUM(o.Quantity * o.UnitPrice), 0) >= :minimum_total\nORDER BY c.CustomerID;"
        },
        "state": "69485ac6-4ce8-4185-9a57-9d5f60dce75e:14"
      }
